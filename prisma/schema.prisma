generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// O schema canônico é mantido em supabase/migrations/*.sql (DB-first).
// Este arquivo serve para gerar tipos do Prisma Client. Quando o SQL mudar,
// atualizar este arquivo manualmente em paralelo.
//
// Conexão Supabase: usamos @prisma/adapter-pg (driver adapter) na runtime
// porque Prisma 7 removeu `directUrl` do schema. O adapter aceita a string
// pooled (pgbouncer) sem limitações.

/// Mirror de auth.users (Supabase Auth) com campos de domínio do Norte.
/// Row criada automaticamente por trigger SQL (vide supabase/migrations).
model User {
  id          String    @id @db.Uuid
  email       String    @unique
  name        String?
  onboardedAt DateTime? @map("onboarded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  subscriptionTier      String    @default("free") @map("subscription_tier")
  trialEndsAt           DateTime? @map("trial_ends_at")
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?   @unique @map("stripe_subscription_id")
  subscriptionStatus    String?   @map("subscription_status")
  subscriptionEndsAt    DateTime? @map("subscription_ends_at")

  @@map("users")
}

model Goal {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String
  type            String              @default("custom")
  target          Decimal             @db.Decimal(14, 2)
  current         Decimal             @default(0) @db.Decimal(14, 2)
  deadline        DateTime            @db.Date
  priority        Int                 @default(1) @db.SmallInt
  linkedAccountId String?             @map("linked_account_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  contributions   GoalContribution[]

  @@index([userId], map: "goals_user_id_idx")
  @@index([userId, deadline], map: "goals_user_deadline_idx")
  @@map("goals")
}

model GoalContribution {
  id             String   @id @default(uuid()) @db.Uuid
  goalId         String   @map("goal_id") @db.Uuid
  amount         Decimal  @db.Decimal(14, 2)
  contributedAt  DateTime @default(now()) @map("contributed_at")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId], map: "goal_contributions_goal_id_idx")
  @@map("goal_contributions")
}
